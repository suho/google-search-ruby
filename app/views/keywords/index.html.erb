<div class="modal-dialog modal-content p-4">

  <h4>Upload Keywords File</h4><br>

  <%= form_with url: keywords_path do |f| %>

    <div class="form-group">
      <%= f.file_field :keywords_file, accept: 'text/csv', required: true %>
    </div>

    <div class="form-group">
      <%= f.submit "Upload and Search", class: "form-control btn btn-primary" %>
    </div>
    <div class="form-group">
      <%= link_to "Need template file? Download here!", "/files/template.csv" %><br/>
    </div>

  <% end %>

</div>
<% if not @decorated_keywords.empty? %>
  <%== pagy_bootstrap_nav(@pagy) %>
  <table class="table table-hover">
    <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Keyword</th>
      <th scope="col">Created At</th>
      <th scope="col">Status</th>
    </tr>
    </thead>
    <tbody>
    <% @decorated_keywords.each_with_index { |decorated_keyword, index| %>
      <tr>
        <th scope="row"><%= index + 1 %></th>
        <td><%= decorated_keyword.keyword %></td>
        <td><%= decorated_keyword.created_at %></td>
        <td><%= raw decorated_keyword.status_html %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
<% end %>
